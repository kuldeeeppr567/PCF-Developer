{
  "name": "PCF Developer Agent",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:18",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    }
  },
  "postCreateCommand": "dotnet tool install --global Microsoft.PowerApps.CLI.Tool && export PATH=\"$PATH:$HOME/.dotnet/tools\" && echo 'export PATH=\"$PATH:$HOME/.dotnet/tools\"' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [8181],
  "portsAttributes": {
    "8181": {
      "label": "PCF Test Harness",
      "onAutoForward": "openBrowser"
    }
  }
}
